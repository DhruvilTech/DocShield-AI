{
  "required_fields": [
    "permit_number",
    "name",
    "permit_type",
    "date_of_expiry"
  ],
  "patterns": {
    "permit_number": "^[A-Z]{2}[0-9]{2}(?:19|20)[0-9]{2}[A-Z0-9]{5,8}$",
    "name":          "^[A-Z][A-Za-z .]{1,99}$",
    "permit_type":   "^(?:national|state|tourist|goods|taxi|maxi-cab|contract-carriage|stage-carriage|educational-institution)$",
    "rto_code":      "^[A-Z]{2}[0-9]{2}$",
    "vehicle_no":    "^[A-Z]{2}[0-9]{2}[A-Z]{1,2}[0-9]{4}$"
  },
  "date_rules": {
    "date_of_expiry": {
      "must_be_after_today": true
    }
  }
}