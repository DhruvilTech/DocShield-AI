{
  "required_fields": [
    "id_number",
    "name",
    "date_of_birth"
  ],
  "patterns": {
    "id_number":    "^[2-9][0-9]{11}$",
    "id_spaced":    "^[2-9][0-9]{3}\\s[0-9]{4}\\s[0-9]{4}$",
    "name":         "^[A-Z][A-Za-z .]{1,99}$",
    "gender":       "^(?:M|F|Male|Female|Third Gender)$",
    "pin_code":     "^[1-9][0-9]{5}$",
    "vid":          "^[2-9][0-9]{15}$"
  },
  "date_rules": {
    "date_of_birth": {
      "must_be_past": true
    }
  }
}