# Application
APP_NAME=DocShield AI
APP_VERSION=1.0.0
APP_ENV=development

# API
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Logging
LOG_LEVEL=INFO

# OCR engine
OCR_LANGUAGE=en
OCR_USE_GPU=false
OCR_CONFIDENCE_THRESHOLD=0.75

# Image preprocessing
ENABLE_PREPROCESSING=false

# File upload limits
MAX_FILE_SIZE_MB=10
SUPPORTED_FILE_TYPES=["image/jpeg","image/png","image/tiff","application/pdf"]
