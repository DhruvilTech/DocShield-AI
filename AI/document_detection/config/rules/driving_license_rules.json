{
  "required_fields": [
    "license_number",
    "name"
  ],
  "patterns": {
    "license_number": "^[A-Z]{2}[0-9]{2}(?:19|20)[0-9]{2}[0-9]{7}$",
    "name":           "^[A-Z][A-Za-z .'-]{1,98}$",
    "vehicle_class":  "^(?:LMV|MCWG|MCWOG|HPMV|HTV|HGV|MGV|LPV|LDRXCV|ADAPT|TR|NT)(?:[,/ ]*(?:LMV|MCWG|MCWOG|HPMV|HTV|HGV|MGV|LPV|LDRXCV|ADAPT|TR|NT))*$",
    "rto_code":       "^[A-Z]{2}[0-9]{2}$",
    "blood_group":    "^(?:A|B|AB|O)[+-]?$"
  },
  "date_rules": {
    "date_of_birth": {
      "must_be_past": true
    },
    "date_of_expiry": {
      "must_be_after_today": true
    }
  }
}