{
  "required_fields": [
    "permit_number",
    "name",
    "permit_type"
  ],
  "patterns": {
    "permit_number": "^(?:[A-Z]{2}[0-9]{2}(?:19|20)[0-9]{2}[A-Z0-9]{5,8}|[0-9]{8,22}|[A-Z0-9\\-_/]{5,25})$",
    "name":          "^[A-Z][A-Za-z .]{1,99}$",
    "permit_type":   "^(?:single|multiple|temporary|inner-line|ilp|eilp|business|labor|labour|tourist|national|state|goods|taxi|maxi-cab|contract-carriage|stage-carriage|educational-institution|work|transit|resident|special-entry).*$",
    "rto_code":      "^[A-Z]{2}[0-9]{2}$",
    "vehicle_no":    "^(?:[A-Z]{2}[0-9]{2}[A-Z]{1,2}[0-9]{4}|[A-Z0-9\\-\\s]{4,15})?$"
  },
  "date_rules": {
    "date_of_expiry": {
      "must_be_after_today": false
    }
  }
}