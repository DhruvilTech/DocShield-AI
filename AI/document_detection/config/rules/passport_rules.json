{
  "required_fields": [
    "passport_number",
    "name",
    "nationality",
    "date_of_birth",
    "date_of_expiry"
  ],
  "patterns": {
    "passport_number": "^(?:[A-Z][0-9]{7}|[A-Z]{2}[0-9]{6,7})$",
    "nationality":     "^(?:IND|INDIAN|INDIA)$",
    "name":            "^[A-Z][A-Z ]{1,38}[A-Z]$",
    "mrz_line1":       "^P<[A-Z]{3}[A-Z<]{39}$",
    "mrz_line2":       "^[A-Z0-9<]{9}[0-9][A-Z]{3}[0-9]{6}[0-9][MFX<][0-9]{6}[0-9][A-Z0-9<]{14}[0-9<][0-9]$",
    "file_number":     "^[A-Z]{1,2}[A-Z0-9]{10,11}$"
  },
  "date_rules": {
    "date_of_birth": {
      "must_be_past": true
    },
    "date_of_expiry": {
      "must_be_after_today": true,
      "must_be_after_dob": true
    }
  }
}