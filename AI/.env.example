# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=DocShield AI Engine
APP_VERSION=1.0.0
APP_ENV=development

# ── API ───────────────────────────────────────────────────────────────────────
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── OCR Engine (Document Detection) ──────────────────────────────────────────
OCR_LANGUAGE=en
OCR_USE_GPU=false
OCR_CONFIDENCE_THRESHOLD=0.75

# ── Image Preprocessing (Document Detection) ─────────────────────────────────
ENABLE_PREPROCESSING=false

# ── File Upload Limits ────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
SUPPORTED_FILE_TYPES=["image/jpeg","image/png","image/tiff","application/pdf"]

# ── Forensic / Image Tampering ────────────────────────────────────────────────
FORENSIC_SUPPORTED_FORMATS=["image/jpeg","image/png","image/webp"]
FORENSIC_MAX_FILE_SIZE_MB=50
FORENSIC_DEBUG_DIR=outputs/debug

# ── Face Verification ────────────────────────────────────────────────────────
FACE_MATCH_THRESHOLD=0.45
FACE_LIVENESS_TIMEOUT=10.0
